{
  "name": "pocket-cosmos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A little universe to draw, play and share with family",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.js",
    "dev": "node scripts/build.mjs && node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test && npm run build",
    "build:pages": "node scripts/build.mjs --pages"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.22.0",
    "jsqr": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
